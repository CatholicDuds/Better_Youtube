{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "audits"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "audits": { "type": "object", "additionalProperties": { "$ref": "#/$defs/audit" } }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "audit": {
      "type": "object",
      "required": ["approved", "method", "overall", "depth", "insight", "evidence", "captivating", "thesis", "reasons", "auditedAt", "transcriptSource", "evidenceQuotes", "goalRelevance"],
      "properties": {
        "approved": { "type": "boolean" },
        "method": { "const": "semantic-content" },
        "overall": { "$ref": "#/$defs/score" }, "depth": { "$ref": "#/$defs/score" },
        "insight": { "$ref": "#/$defs/score" }, "evidence": { "$ref": "#/$defs/score" }, "captivating": { "$ref": "#/$defs/score" },
        "thesis": { "type": "string", "minLength": 1 },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "auditedAt": { "type": "string", "format": "date-time" },
        "transcriptSource": { "enum": ["youtube-captions", "transcript-published", "primary-source", "none"] },
        "evidenceQuotes": {
          "type": "array", "maxItems": 2,
          "items": {
            "type": "object", "required": ["text", "timestamp"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 240 },
              "timestamp": { "type": ["string", "null"], "pattern": "^(?:[0-9]+:)?[0-9]{1,2}:[0-5][0-9]$" },
              "locator": { "type": "string", "minLength": 1 }
            }
          }
        },
        "goalRelevance": {
          "type": "object", "required": ["goalIds", "reason", "discovery"],
          "properties": {
            "goalIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "reason": { "type": "string", "minLength": 1 },
            "discovery": { "type": "boolean" }
          }
        },
        "exceptionalJustification": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "transcriptSource": { "const": "none" } } }, "then": { "properties": { "approved": { "const": false } } } },
        { "if": { "properties": { "approved": { "const": true } } }, "then": {
          "properties": { "evidenceQuotes": { "minItems": 1 } },
          "allOf": [
            { "if": { "properties": { "transcriptSource": { "const": "primary-source" } } }, "then": { "properties": { "evidenceQuotes": { "items": { "required": ["locator"] } } } }, "else": { "properties": { "evidenceQuotes": { "items": { "properties": { "timestamp": { "type": "string" } } } } } } },
            { "if": { "properties": { "goalRelevance": { "properties": { "discovery": { "const": false } } } } }, "then": { "properties": { "goalRelevance": { "properties": { "goalIds": { "minItems": 1 } } } } } },
            { "if": { "anyOf": [ { "properties": { "overall": { "exclusiveMinimum": 90 } } }, { "properties": { "depth": { "exclusiveMinimum": 90 } } }, { "properties": { "insight": { "exclusiveMinimum": 90 } } }, { "properties": { "evidence": { "exclusiveMinimum": 90 } } }, { "properties": { "captivating": { "exclusiveMinimum": 90 } } } ] }, "then": { "required": ["exceptionalJustification"] } }
          ]
        } }
      ]
    }
  }
}
